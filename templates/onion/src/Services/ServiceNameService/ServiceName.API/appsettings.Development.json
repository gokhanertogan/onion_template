{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Set to "Information" to see generated SQL (the outbox poller makes it chatty).
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": false,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "ConnectionStrings": {
    // Local development only (matches docker-compose.yml). Never put real credentials here.
//#if (UsePostgres)
    "ServiceNameDb": "Host=localhost;Port=5432;Database=servicename;Username=postgres;Password=postgres"
//#elif (UseSqlite)
    "ServiceNameDb": "Data Source=servicename.db"
//#else
    "ServiceNameDb": "Server=localhost,1433;Database=ServiceName;User Id=sa;Password=Dev_Passw0rd!;TrustServerCertificate=True;Encrypt=True"
//#endif
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Outbox": {
    "PollingInterval": "00:00:01"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "OpenApi": {
    "Enabled": true
  }
}
