<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs templates/** into a NuGet template package:
      dotnet pack Onion.Templates.csproj -o artifacts
      dotnet new install artifacts/OnionArchitecture.Templates.1.0.0.nupkg
  -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>OnionArchitecture.Templates</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>Clean Architecture / Onion Architecture .NET 10 Microservice Template (DDD, CQRS, no MediatR)</Title>
    <Authors>Gökhan Ertoğan</Authors>
    <Description>dotnet new template for a production-ready ASP.NET Core 10 Web API microservice: Onion / Clean Architecture, DDD, CQRS with a built-in mediator (MediatR alternative), validation (FluentValidation alternative), result pattern, transactional outbox, EF Core (SQL Server, PostgreSQL, SQLite), HybridCache, JWT and permission-based auth, OpenAPI, Docker and tests. Zero third-party NuGet dependencies. Usage: dotnet new onion -n Order</Description>
    <PackageTags>dotnet-new;templates;template;project-template;clean-architecture;onion-architecture;cleanarchitecture;ddd;domain-driven-design;cqrs;microservice;microservices;aspnetcore;webapi;minimal-api;efcore;outbox;vertical-slice;mediator;mediatr-alternative;result-pattern;net10</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gokhanertogan/onion_template</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gokhanertogan/onion_template.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/gokhanertogan/onion_template/releases</PackageReleaseNotes>
    <Copyright>Copyright (c) Gökhan Ertoğan</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*"
             Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.vs\**;templates\**\TestResults\**;templates\**\*.db;templates\**\.DS_Store"
             PackagePath="content" />
    <None Include="assets\PACKAGE_README.md" Pack="true" PackagePath="\README.md" />
    <None Include="assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
