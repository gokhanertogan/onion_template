<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs templates/** into a NuGet template package:
      dotnet pack Onion.Templates.csproj -o artifacts
      dotnet new install artifacts/OnionArchitecture.Templates.1.0.0.nupkg
  -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>OnionArchitecture.Templates</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>Onion Architecture Microservice Template</Title>
    <Authors>Gökhan Ertoğan</Authors>
    <Description>Production-ready .NET 10 microservice template: Onion/Clean architecture, DDD, CQRS, zero third-party dependencies.</Description>
    <PackageTags>dotnet-new;templates;onion;clean-architecture;ddd;cqrs;microservice</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*"
             Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.vs\**;templates\**\TestResults\**;templates\**\*.db;templates\**\.DS_Store"
             PackagePath="content" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
