root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# ---------------------------------------------------------------------------
# Style
# ---------------------------------------------------------------------------
# Using directives live inside the namespace. Service name == aggregate name
# (e.g. Order.Domain.Orders.Order), so placing usings inside the namespace lets
# the type win over the root namespace during name lookup.
csharp_using_directive_placement = inside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning

csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_new_line_before_open_brace = all

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_readonly_field = true:warning

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

# ---------------------------------------------------------------------------
# Analyzer tuning (AnalysisMode = Recommended)
# ---------------------------------------------------------------------------
# Nullable reference types already cover argument null checks.
dotnet_diagnostic.CA1062.severity = none
# ASP.NET Core has no SynchronizationContext.
dotnet_diagnostic.CA2007.severity = none
# Domain/CQRS naming ("...EventHandler", "...Command") is intentional.
dotnet_diagnostic.CA1711.severity = none
# Generic static members are part of the Result / factory APIs.
dotnet_diagnostic.CA1000.severity = none
# Messages are developer-facing, not localized.
dotnet_diagnostic.CA1303.severity = none
# Primary constructors and DI make these noisy.
dotnet_diagnostic.CA1812.severity = none
# Route/URL values are strings in Minimal APIs.
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1054.severity = none
# Collection properties on DTOs/records are fine.
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1002.severity = none
# Namespace "Domain", "Application" etc. are intentional.
dotnet_diagnostic.CA1716.severity = none
# Culture: invariant handling is explicit where it matters.
dotnet_diagnostic.CA1308.severity = none
# Static holder types for errors/permissions.
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1034.severity = none
# Base exception constructors are not required for internal exception types.
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.CA1064.severity = none

[**/*Tests/**.cs]
# Test method names use underscores: Method_State_Expected
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA5394.severity = none

[**/Migrations/*.cs]
# EF Core generated code: excluded from style and quality rules.
generated_code = true
dotnet_analyzer_diagnostic.severity = none
